# Copy to .env on the deployment host, keep mode 0600, and never commit .env.
ANALYTICS_STATE_DIR=/path/to/analytics-shadow
PRESENTATION_DATA_DIR=/path/to/presentation-data
GRAFANA_DATA_DIR=/path/to/grafana-data
GRAFANA_BIND_IP=192.168.1.10
SNAPSHOT_IMAGE=ai-security-observer-presentation-snapshot:COMMIT
GRAFANA_IMAGE=ai-security-observer-grafana:12.4.13-COMMIT
GRAFANA_ADMIN_PASSWORD=<set-locally-to-a-long-random-secret>
